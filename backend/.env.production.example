# Production Environment Variables for Backend
# ⚠️ IMPORTANT: Copy this to .env.production and fill in real values
# ⚠️ DO NOT commit .env.production to version control

# Application Settings
APP_NAME=Aryan Tech World - Client Management System
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
# Generate strong password: openssl rand -base64 32
MONGODB_URL=mongodb://admin:CHANGE_THIS_PASSWORD@mongodb:27017/aryan_tech_db?authSource=admin
MONGODB_DB_NAME=aryan_tech_db
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20

# Redis Configuration
# Generate strong password: openssl rand -base64 32
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379/0

# JWT Authentication
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
# Update with your production domain
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-production-bucket

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx

# Celery
CELERY_BROKER_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_PASSWORD@redis:6379/0
