# Production Environment Variables for Frontend
# ⚠️ IMPORTANT: Copy this to .env.production and fill in real values
# ⚠️ These variables are embedded in the build, so rebuild after changes

# API Base URL - REQUIRED
# Must be your production API URL
VITE_API_BASE_URL=https://api.yourdomain.com

# App Settings
VITE_APP_NAME=Aryan Tech World - Client Management System
VITE_APP_VERSION=1.0.0

# Analytics (Optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN (Optional)
# VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
